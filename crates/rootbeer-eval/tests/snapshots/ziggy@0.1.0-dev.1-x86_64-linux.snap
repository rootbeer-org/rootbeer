# op5vxkgp5mljbf5qpkjgxk7xobwgnvxa
kind: build
name: ziggy
version: 0.1.0-dev.1
platform: x86_64-linux
sandbox: linux-v1
inputs:
  source: btesvzirtlgwsyo7zmq7pfbwwgw25enj
  vendor: xvwyw4p2habl6royfcz4rvpdpvabkj6x
dependencies:
  - zig (build) lhibbzbghj2fv4vkznnwakwemakfbvxy
env:
  RB_SYSTEM: builder-sha256:0000
outputs:
  - out
script: |
  set -eu
  tar -xzf "${source}" -C .
  cd ziggy-294212ebd35f5b755062186a66bcfd6436d3627a
  export ZIG_GLOBAL_CACHE_DIR="${PWD}/zig-global-cache" ZIG_LOCAL_CACHE_DIR="${PWD}/zig-cache"
  mkdir zig-global-cache
  cp -R "${vendor}" zig-global-cache/p
  chmod -R u+w zig-global-cache/p
  zig build --prefix "${out}" "-j${jobs}" -Doptimize=ReleaseSafe -Dversion=0.1.0-dev.1
