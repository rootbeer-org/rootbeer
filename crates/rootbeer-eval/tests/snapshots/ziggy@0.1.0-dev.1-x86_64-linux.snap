platform: x86_64-linux
sandbox: linux-v1-net
inputs:
  source: btesvzirtlgwsyo7zmq7pfbwwgw25enj
dependencies:
  - zig (build) lhibbzbghj2fv4vkznnwakwemakfbvxy
outputs:
  - out
script: |
  set -eu
  tar -xzf "${source}" -C .
  cd ziggy-294212ebd35f5b755062186a66bcfd6436d3627a
  mkdir -p "${TMPDIR}/zig/tmp"
  zig build --fetch=all --global-cache-dir "${TMPDIR}/zig"
  mkdir -p "${TMPDIR}/zig/p"
