urls:
  - https://example.com/libz-1.3.2.tar.xz

# b6c5y4isqpbp3zazamvelgiwgq3eatpj
kind: build
name: libz
version: 1.3.2
platform: x86_64-linux
sandbox: linux-v1
inputs:
  source: 46ju3wvob5d7a26rjdk7mbpceliybsev
dependencies:
  - tool (build) ydbvnsmjxthg5pnlcpdou7oy2xyqh6p3
  - tool (linked) ydbvnsmjxthg5pnlcpdou7oy2xyqh6p3
env:
  RB_SYSTEM: builder-sha256:0000
outputs:
  - out
script: |
  set -eu
  tar -xJf "${source}" -C .
  cd libz-1.3.2
  patch --batch -p1 <<'RB_PATCH'
  --- a/Makefile
  +++ b/Makefile
  @@ -1 +1 @@
  -CFLAGS = -O3
  +CFLAGS = -O2
  RB_PATCH
  ./configure "--prefix=${out}" --with-tool=/opt/rb/store/ydbvnsmjxthg5pnlcpdou7oy2xyqh6p3-tool-2.0.0
  make "-j${jobs}" VERSION=1.3
  make install
  sh -c "echo \"\$1\" > ${out}/note" note "it's \`done\`"

# qk53pwcdvrzu7ks372mfeibfhqhpoxvg
kind: check
name: libz
target: b6c5y4isqpbp3zazamvelgiwgq3eatpj
platform: x86_64-linux
sandbox: linux-v1
env:
  RB_SYSTEM: builder-sha256:0000
script: |
  set -eu
  find . -exec true "{}" ";"
  test -e "${target}/lib/libz.a"
  test -e "${target}/lib/libz.so"
