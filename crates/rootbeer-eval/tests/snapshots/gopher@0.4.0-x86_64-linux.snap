# oxwds6bv5rm75pxp65ffbezfkvw2swoo
kind: fetch
sha256: 5555555555555555555555555555555555555555555555555555555555555555
urls:
  - https://example.com/gopher/archive/v0.4.0.tar.gz

# i3yrl3lazfiab3dr5kcqiexg7xsiwlxm
kind: build
name: gopher-vendor
version: 0.4.0
platform: x86_64-linux
sandbox: linux-v1-net
inputs:
  source: oxwds6bv5rm75pxp65ffbezfkvw2swoo
dependencies:
  - go (build) lyzroo6dvybks5qy55mjsbrs42iwranj
env:
  GO111MODULE: on
  GOENV: off
  GOFLAGS: -modcacherw
  GOPROXY: https://proxy.golang.org
  GOSUMDB: sum.golang.org
  GOTOOLCHAIN: local
  GOWORK: off
outputs:
  - out
script: |
  set -eu
  tar -xzf "${source}" -C .
  cd gopher-0.4.0
  export GOPATH="${TMPDIR}/go" GOMODCACHE="${TMPDIR}/go-modules" GOCACHE="${TMPDIR}/go-cache"
  cp go.mod go.sum "${TMPDIR}"
  mkdir -p vendor
  go mod vendor
  cmp go.mod "${TMPDIR}/go.mod"
  cmp go.sum "${TMPDIR}/go.sum"
  go mod verify
  cp -R vendor "${out}"

# uu3vxbnqtsw3tdn4ojlkjnniu5eto74g
kind: build
name: gopher
version: 0.4.0
platform: x86_64-linux
sandbox: linux-v1
inputs:
  source: oxwds6bv5rm75pxp65ffbezfkvw2swoo
  vendor: i3yrl3lazfiab3dr5kcqiexg7xsiwlxm
dependencies:
  - go (build) lyzroo6dvybks5qy55mjsbrs42iwranj
env:
  CGO_ENABLED: 0
  GO111MODULE: on
  GOENV: off
  GOEXPERIMENT: greenteagc
  GOFLAGS: -mod=vendor
  GOPROXY: off
  GOSUMDB: off
  GOTOOLCHAIN: local
  GOVCS: *:off
  GOWORK: off
  RB_SYSTEM: builder-sha256:0000
outputs:
  - out
script: |
  set -eu
  tar -xzf "${source}" -C .
  cd gopher-0.4.0
  rm -r testdata
  rm -rf vendor
  cp -R "${vendor}" vendor
  export GOPATH="${TMPDIR}/go" GOCACHE="${TMPDIR}/go-cache"
  go generate -tags netgo,osusergo ./internal/gen
  mkdir -p "${out}/bin"
  go build -trimpath -buildvcs=false -p "${jobs}" -tags netgo,osusergo -ldflags "-X 'main.version=0.4.0'" -o "${out}/bin/gopher" ./cmd/gopher
  ln -s gopher "${out}/bin/gph"
