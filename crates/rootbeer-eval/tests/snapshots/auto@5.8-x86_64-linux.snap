# gskd7oqlctnsyj5ziiallfivhtzbfp27
kind: fetch
sha256: 1111111111111111111111111111111111111111111111111111111111111111
urls:
  - https://example.com/auto-5.8.tar.gz

# bipfmhbihkeqclkp3ux5mniqc5bn2gdc
kind: build
name: auto
version: 5.8
platform: x86_64-linux
sandbox: linux-v1
inputs:
  source: gskd7oqlctnsyj5ziiallfivhtzbfp27
dependencies:
  - libz (linked) f5bo4mtpggcspiokfi2mbylipiq5viqa
env:
  RB_SYSTEM: builder-sha256:0000
outputs:
  - out
script: |
  set -eu
  tar -xzf "${source}" -C .
  cd auto-5.8
  sh ./configure --prefix=/ --disable-nls "--with-z=${deps}"
  make "-j${jobs}"
  make check
  make "DESTDIR=${out}" install
