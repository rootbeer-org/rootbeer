# sveyo4w2yfdhkddym2vqexv7zu6qbq5w
kind: fetch
sha256: 2222222222222222222222222222222222222222222222222222222222222222
urls:
  - https://example.com/Slides-2.0.zip

# i43p5nat2wscmxy3j4ffanemzi6zknb2
kind: extract
tree: cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
source: sveyo4w2yfdhkddym2vqexv7zu6qbq5w
format: zip

# 5dxku6ysms5u2py3qwoxq6xe6feak2e2
kind: build
name: slides
version: 2.0
platform: aarch64-macos
sandbox: darwin-v1
inputs:
  unpacked: i43p5nat2wscmxy3j4ffanemzi6zknb2
outputs:
  - out
script: |
  set -eu
  ditto "${unpacked}" "${out}"
  chmod -R u+w "${out}"
  mkdir -p "${out}/bin"
  ln -s ../Slides.app/Contents/MacOS/slides "${out}/bin/slides"
