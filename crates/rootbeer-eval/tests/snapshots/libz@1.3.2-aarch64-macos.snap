---
source: crates/rootbeer-eval/tests/eval.rs
---

# 46ju3wvob5d7a26rjdk7mbpceliybsev
kind: fetch
sha256: 6666666666666666666666666666666666666666666666666666666666666666
urls:
  - https://example.com/libz-1.3.2.tar.xz

# 6rfsqzgtuq3zdsnioc7xo2zy6wldzqpt
kind: build
name: libz
version: 1.3.2
platform: aarch64-macos
sandbox: darwin-v1
inputs:
  source: 46ju3wvob5d7a26rjdk7mbpceliybsev
dependencies:
  - tool (build) e3rtcvq5o2vghgq5chw5txhptocnekd2
  - tool (linked) e3rtcvq5o2vghgq5chw5txhptocnekd2
env:
  RB_SYSTEM: builder-sha256:0000
outputs:
  - out
script: |
  set -eu
  tar -xJf "${source}" -C .
  cd libz-1.3.2
  patch --batch -p1 <<'RB_PATCH'
  --- a/Makefile
  +++ b/Makefile
  @@ -1 +1 @@
  -CFLAGS = -O3
  +CFLAGS = -O2
  RB_PATCH
  export LDFLAGS="-Wl,-S -Wl,-rpath,${out}/lib"
  ./configure "--prefix=${out}" --with-tool=/opt/rb/store/e3rtcvq5o2vghgq5chw5txhptocnekd2-tool-2.0.0
  make "-j${jobs}" VERSION=1.3
  make install
  sh -c "echo \"\$1\" > ${out}/note" note "it's \`done\`"

# 4mgppdccufh6gc3hs5dhgw5xcnevudoi
kind: check
name: libz
target: 6rfsqzgtuq3zdsnioc7xo2zy6wldzqpt
platform: aarch64-macos
sandbox: darwin-v1
env:
  RB_SYSTEM: builder-sha256:0000
script: |
  set -eu
  find . -exec true "{}" ";"
  test -e "${target}/lib/libz.a"
  test -e "${target}/lib/libz.dylib"
