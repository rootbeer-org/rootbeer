# tcb3jgtx37py5uh7zo2h4tzielwf33pi
kind: fetch
sha256: cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
urls:
  - https://github.com/ip7z/7zip/releases/download/26.04/7z2604-linux-x64.tar.xz

# 627vsva546vzy2c4d63obobfzdscxvrv
kind: build
name: 7zip
version: 26.04
platform: x86_64-linux
sandbox: linux-v1
inputs:
  source: tcb3jgtx37py5uh7zo2h4tzielwf33pi
outputs:
  - out
script: |
  set -eu
  mkdir -p "${out}"
  tar -xJf "${source}" -C "${out}"
  mkdir -p "${out}/bin"
  ln -s ../7zzs "${out}/bin/7zz"
